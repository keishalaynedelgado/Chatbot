PORT=3000

# ==============================================================================
# Vercel AI SDK Provider & Model Configuration Examples
# ==============================================================================

# Option 1: NVIDIA NIM (Default - Ultra-fast / High intelligence)
DEFAULT_AI_PROVIDER=nvidia
DEFAULT_AI_MODEL=meta/llama-3.1-8b-instruct
# Or for 70B:
# DEFAULT_AI_PROVIDER=nvidia
# DEFAULT_AI_MODEL=meta/llama-3.3-70b-instruct

# Option 2: Google Gemini
# DEFAULT_AI_PROVIDER=google
# DEFAULT_AI_MODEL=gemini-2.5-flash

# Option 3: OpenAI
# DEFAULT_AI_PROVIDER=openai
# DEFAULT_AI_MODEL=gpt-4o-mini

# Option 4: SCX AI
# DEFAULT_AI_PROVIDER=scx
# DEFAULT_AI_MODEL=MiniMax-M2.7

# ==============================================================================
# AI Provider API Keys (Set the key for your desired provider)
# ==============================================================================
SCX_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

