# Dependencies
node_modules/

# Environment variables & secrets (CRITICAL: DO NOT COMMIT)
.env
.env.local
.env.*.local

# Logs and debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS generated files
.DS_Store
Thumbs.db

# Cloned reference repositories
task-management-system/

# Generated documents (AI Template Autofill output)
backend/generated-files/*
!backend/generated-files/.gitkeep

# User-uploaded knowledge-base documents (may contain confidential content)
backend/uploaded-documents/*
!backend/uploaded-documents/.gitkeep

# Frontend production build output (reproducible via `npm run build`)
frontend/dist/
